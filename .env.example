# Copy this file to .env and fill in whichever you have.
# The app runs fine with NONE of these set (offline rule-based mode).

# auto | anthropic | openai | offline
LLM_PROVIDER=auto

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional overrides
# RETAIL_DB_PATH=data/retail.db
# MAX_ROWS=2000
